---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sneyder Angulo | Software a la medida para tu negocio",
  description = "Desarrollo de software a la medida en Barquisimeto. Agenda, pedidos, cobros y reportes en un solo sistema para consultorios, gimnasios y distribuidoras.",
} = Astro.props;

const siteUrl = "https://sneyderangulo.com";
const ogImage = `${siteUrl}/meta.jpg`;
const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Sneyder Angulo" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@SneyderHack" />
    <meta name="twitter:site" content="@SneyderHack" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Global Styles -->
    <style is:global>
      :root {
        --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI",
          Roboto, "Helvetica Neue", Arial, sans-serif;
      }

      body {
        font-family: var(--font-sans);
      }
    </style>

    {
      isProd && (
        <>
          <!-- Umami Analytics (prod only) -->
          <script
            async
            defer
            data-website-id="ba5839db-6d23-40cc-805e-9b17b7a6da5e"
            src="https://analytics.sneyderangulo.com/script.js"
          ></script>
        </>
      )
    }
  </head>
  <body class="bg-black text-white antialiased">
    <slot />
  </body>
</html>

